{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Shared permissions for desktop and mobile. Vault work goes through Lados commands.",
  "windows": ["main"],
  "webviews": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "dialog:default",
    "fs:default",
    "clipboard-manager:allow-write-text",
    "clipboard-manager:allow-write-secret",
    "clipboard-manager:allow-clear",
    "opener:default"
  ]
}
