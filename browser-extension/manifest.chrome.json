{
  "manifest_version": 3,
  "name": "Lados",
  "version": "0.3.0",
  "description": "Autofill logins from your local Lados vault. Offline, no account, no cloud.",
  "homepage_url": "https://github.com/adrijuse395/lados",
  "minimum_chrome_version": "116",
  "permissions": [],
  "host_permissions": ["http://127.0.0.1:18765/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Lados",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    },
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
