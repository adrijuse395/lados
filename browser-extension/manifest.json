{
  "manifest_version": 2,
  "name": "Lados",
  "version": "0.3.0",
  "description": "Autofill logins from your local Lados vault. Offline, no account, no cloud.",
  "homepage_url": "https://github.com/adrijuse395/lados",
  "browser_specific_settings": {
    "gecko": {
      "id": "lados@adrijuse395.github.io",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": ["http://127.0.0.1:18765/*"],
  "background": {
    "scripts": ["background.js"]
  },
  "browser_action": {
    "default_title": "Lados",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    },
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
